# Copy to .env and fill in. Never commit real values.
STATUS=development
DEV_PORT=8000
PROD_PORT=8001

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=mailing_tracker

# At least 32 random characters each (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
JWT_SECRET=
# Encrypts stored SMTP passwords. Changing it makes saved SMTP passwords unreadable.
SMTP_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Public URL of this API; used to build the unsubscribe link in outgoing emails
PUBLIC_API_URL=http://localhost:8000

# Worker tuning (milliseconds)
WORKER_TICK_MS=30000
MAIL_SEND_INTERVAL_MS=180000

# Development only: allow SMTP hosts on private networks / any port (e.g. MailHog on localhost:1025)
ALLOW_PRIVATE_SMTP_HOSTS=false
